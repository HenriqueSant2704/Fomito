# Copie este arquivo para ".env" e preencha. O ".env" nunca vai para o GitHub.

# Banco Neon do Fomito (Neon → seu projeto → Connection string)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/fomito?sslmode=require

# Segredo das sessões de login (pelo menos 16 caracteres, aleatório).
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JWT_SECRET=

# Primeiro administrador: criado sozinho na primeira vez que o servidor liga
# (só se ainda não existir nenhum). Depois ele cria garçons e motoboys pelo painel.
ADMIN_USER=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=

# Opcional: chave da Evolution API fora do banco (se preencher, vale esta).
# EVOLUTION_API_KEY=

# Porta local (o Render define a dele sozinho)
PORT=3000
